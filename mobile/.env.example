# Tint Notes mobile — names only; values live in mobile/.env (gitignored) and EAS secrets.
# Same Supabase project as the website and SnapTip.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# legacy, read only if the publishable key is unset; Supabase retires it in 2027
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The website that hosts the moderation + email-confirm bridge endpoints.
EXPO_PUBLIC_SITE_URL=https://tintnotes.com
# Cloudflare Turnstile site key (same one the website uses). Required while
# Supabase Auth CAPTCHA is on; unset = no token is sent with sign-in / sign-up.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
